# Mining Guardian M0/M1 configuration
SRBMINER_API_HOST=127.0.0.1
SRBMINER_API_PORT=21550
# Configure this to the read-only statistics endpoint exposed by your SRBMiner build.
# M1 intentionally does not assume /api/stats.
SRBMINER_API_PATH=/
SRBMINER_API_TIMEOUT_SECONDS=5

GPU_INDEX=0
OBSERVE_INTERVAL_SECONDS=10
FRESHNESS_FRESH_MAX_AGE_SECONDS=30
FRESHNESS_RECENT_MAX_AGE_SECONDS=120
DATABASE_PATH=./mining_guardian.db

# Optional metadata only. Mining Guardian never modifies wallets or payouts in M1.
# PAYOUT_COIN=DOGE

LOG_LEVEL=info
